# Alpaca PAPER trading keys (https://app.alpaca.markets → Paper account → API keys).
# The app always trades on the paper API; live keys will be rejected there.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Optional: Claude API key for the news summary in the info tab (https://platform.claude.com).
ANTHROPIC_API_KEY=

# Login for the web page. The app does not start without both.
APP_USER=
APP_PASSWORD=
